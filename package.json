{
  "name": "hyperstitch",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "React component prototyping studio with a twenty-rule Anti-Crutch auditor that grades rendered output.",
  "license": "MIT",
  "main": "./dist/hyperstitch.mjs",
  "module": "./dist/hyperstitch.mjs",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/hyperstitch.mjs"
    },
    "./audit": {
      "types": "./dist/types/audit/index.d.ts",
      "import": "./dist/hyperstitch/audit.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "vite --port 5185 --host",
    "build": "tsc -b && vite build",
    "build:lib": "vite build --config vite.lib.config.ts && tsc -p tsconfig.lib.json",
    "preview": "vite preview --port 5185 --host",
    "test": "npm run build:lib && node --test test/*.test.js",
    "test:only": "node --test test/*.test.js",
    "audit:catalog": "node scripts/audit-catalog.mjs",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly false",
    "build:all": "npm run build:lib && npm run build"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": false
    },
    "react-dom": {
      "optional": false
    }
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.7.2",
    "vite": "^6.0.0"
  }
}
